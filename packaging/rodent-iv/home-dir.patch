 #include "rodent.h"
 
@@ -174,9 +179,23 @@ void SetRodentHomeDir() {
     }
 
 #elif defined (__APPLE__)
-    // #error something should be done here, look for _NSGetExecutablePath(path, &size)
-    // RodentHomeDirWStr = ...
-    
+    // As on Linux: the home is the executable's folder (an empty home made every
+    // folder relative to the one the engine changed into last, so no personality was
+    // found and the Personality option was not offered).
+    RodentHomeDirWStr = Str2WStr(GetEnv("RODENT4HOME"));
+    if (RodentHomeDirWStr != L"") {
+        PathEndSlash(RodentHomeDirWStr);
+        printf_debug("override for home path: '%s'\n", WStr2Str(RodentHomeDirWStr).c_str());
+    } else {
+        char exe_path[PATH_MAX];
+        char real_path[PATH_MAX];
+        uint32_t size = sizeof(exe_path);
+        if (_NSGetExecutablePath(exe_path, &size) == 0 && realpath(exe_path, real_path) != NULL) {
+            *(strrchr(real_path, '/') + 1) = '\0';
+            RodentHomeDirWStr = CStr2WStr(real_path);
+        }
+    }
+
 #elif defined (ANDROID)
     RodentHomeDirWStr = L"";
 
@@ -199,7 +218,10 @@ void SetRodentHomeDir() {
     } else  {
         char exe_path[1024];
         // getting the current executable location ...
-        readlink("/proc/self/exe", exe_path, sizeof(exe_path));
+        // The link's target is not null-terminated: terminate it, or stray bytes
+        // after it make a wrong home directory now and then.
+        ssize_t len = readlink("/proc/self/exe", exe_path, sizeof(exe_path) - 1);
+        exe_path[len > 0 ? len : 0] = '\0';
         *(strrchr(exe_path, '/') + 1) = '\0';
 
         RodentHomeDirWStr = CStr2WStr(exe_path);
