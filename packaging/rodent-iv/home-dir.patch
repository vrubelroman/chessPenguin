+++ b/sources/src/rodenthome.cpp
@@ -22,6 +22,11 @@ If not, see <http://www.gnu.org/licenses/>.
     #include <sys/stat.h>
     #include <unistd.h>
 #endif
+#if defined (__APPLE__)
+    #include <limits.h>
+    #include <stdlib.h>
+    #include <mach-o/dyld.h>
