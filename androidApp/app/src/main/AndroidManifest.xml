<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Games from Lichess and Chess.com, only when asked for (android-ui.md §23). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether there is a network, before a download (the engine's, an update) and a check
         for updates: in both builds. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The app installs its own updates (android-ui.md §25); the second one lets Android
         skip its question when the app installed the previous version itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".ChessPenguinApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.ChessPenguin"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true">
        <!-- One task: a file opened from another app comes to the app already open. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with": PGN, ZIP, 7z, and files of no known type (.cbv, and .pgn
                 from apps that do not know it). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-chess-pgn" />
                <data android:mimeType="application/vnd.chess-pgn" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- "Share" with a file of the same kinds. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-chess-pgn" />
                <data android:mimeType="application/vnd.chess-pgn" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- The package installer's answer to an update (data/AppUpdates.kt). -->
        <receiver
            android:name=".data.InstallResult"
            android:exported="false" />
    </application>

</manifest>
