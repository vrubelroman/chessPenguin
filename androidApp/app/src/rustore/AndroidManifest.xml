<?xml version="1.0" encoding="utf-8"?>
<!-- The RuStore build (build.gradle.kts, buildType "rustore"): the store installs and
     updates the app, so it neither installs packages nor receives the installer's answer. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />
    <application>
        <receiver android:name=".data.InstallResult" tools:node="remove" />
    </application>
</manifest>
